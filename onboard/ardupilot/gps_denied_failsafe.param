# ===========================================================================
# SILM failsafe parameter set  -  ArduPlane 4.7.x (verified against 4.7.2)
# ===========================================================================
# Every name and range below was checked against the ArduPlane 4.7.2 source
# with tools/check_params.py. Re-run that check if you flash another version:
#   python3 tools/check_params.py --src <ardupilot checkout> ardupilot/gps_denied_failsafe.param
#
# Load in Mission Planner: CONFIG > Full Parameter List > Load from file, then
# Write Params and reboot. Then install ardupilot/scripts/silm_gps_loss.lua
# (see FLIGHT_READY.md A1) - this file enables scripting for it.
#
# How GPS loss is handled on this aircraft (three layers, all on the H743):
#   1. ArduPlane dead-reckons automatically on airspeed + learnt wind when GPS
#      is lost (EKF3, with a DCM fallback). No parameter turns this on; it needs
#      a working, calibrated airspeed sensor (ARSPD_USE=1 below).
#   2. silm_gps_loss.lua turns the aircraft for home (RTL) after SLM_GPS_LOSS_S
#      seconds of GPS loss in AUTO, instead of carrying on outward.
#   3. The geofence forces RTL if the (dead-reckoned) position leaves the
#      allowed area, bounding the worst case.
#   EK3_OPTIONS=1 (JammingExpected) makes the EKF re-check GPS quality before
#   trusting GPS again after a loss, so a jammer/spoofer switching off and back
#   on with a bad signal doesn't snap the position to a wrong place.
#
# This is controlled recovery, not GPS-free navigation: dead-reckoning error
# grows with time and wind-estimate error. Values are starting points for a
# 1.4 m, ~1.6 kg hand-launched pusher (stall ~9.5 m/s). Check them in SITL
# first (tools/sitl_failsafe_test.py, FLIGHT_READY.md A3).
# ---------------------------------------------------------------------------

# --- Airspeed: required for dead reckoning without GPS -----------------------
# 1 = use the airspeed sensor (ASPD-4525) for control and estimation.
ARSPD_USE,1
# Speed limits (m/s, indicated). Min ~1.3x level stall, max with margin.
AIRSPEED_MIN,12
AIRSPEED_CRUISE,19
AIRSPEED_MAX,28

# --- EKF3: GPS jamming / spoofing behaviour ----------------------------------
# Bit 0 JammingExpected: after a GPS loss > 2 s, require the EK3_GPS_CHECK
# quality checks to pass before using GPS again.
EK3_OPTIONS,1
# Full GPS quality check set (nsats, HDoP, speed/pos/yaw error, drift).
EK3_GPS_CHECK,31

# --- Scripting: runs silm_gps_loss.lua on the flight controller -------------
SCR_ENABLE,1

# --- RC link (ExpressLRS) failsafe ------------------------------------------
# Enable failsafe on loss of RC.
THR_FAILSAFE,1
# IMPORTANT for link-free missions: the aircraft is EXPECTED to fly out of
# ExpressLRS range while in AUTO.
#  FS_SHORT_ACTN=0: in AUTO no mode change on RC loss; in manual modes -> CIRCLE.
#  FS_LONG_ACTN=0 : in AUTO continue the mission; in manual modes -> RTL.
# (FS_LONG_ACTN=1 would abort every mission to RTL the moment it left radio
#  range - do not use it for this aircraft.)
FS_SHORT_ACTN,0
FS_LONG_ACTN,0
FS_LONG_TIMEOUT,5
# No ground station in flight -> GCS failsafe off (default, stated explicitly).
FS_GCS_ENABL,0

# --- Return to launch --------------------------------------------------------
# RTL altitude above home (metres) and loiter radius at home (metres).
RTL_ALTITUDE,100
RTL_RADIUS,60

# --- Geofence: hard backstop ------------------------------------------------
FENCE_ENABLE,1
# Bitmask: 1 = max altitude, 2 = circle around home -> 3. Add 4 (=7) if you
# also upload an inclusion polygon from Mission Planner.
FENCE_TYPE,3
# 1 = RTL on breach.
FENCE_ACTION,1
# Circle radius around home (m). Must contain your whole mission + margin.
FENCE_RADIUS,1500
# Max altitude (m). Check your legal ceiling (EASA open category: 120 m).
FENCE_ALT_MAX,120
# Distance inside the fence at which it starts acting (m, documented max 10).
FENCE_MARGIN,10

# --- Optional, OFF by default: optical-flow velocity from the Pi ------------
# Only after the bench check in FLIGHT_READY.md B6, and only if you understand
# EKF source sets. Flight safety must never depend on the Pi.
# EK3_SRC2_VELXY,6
